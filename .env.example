# FreeAuth reference app — environment template
# Copy to .env and fill in. ADAPTER selects the database path; only the
# corresponding URL is required at boot (the other is ignored).

# Adapter selection — explicit and symmetric, both equally supported
ADAPTER=mongoose # mongoose | prisma — pick one

# Required when ADAPTER=mongoose
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/freeauth
# Or for local Mongo: mongodb://127.0.0.1:27017/freeauth_dev

# Required when ADAPTER=prisma
DATABASE_URL=postgresql://user:pass@localhost:5432/freeauth_dev

PORT=3000
NODE_ENV=development # development | production | test
FRONTEND_URL=http://localhost:5173 # required in production

ACCESS_TOKEN_SECRET=replace-with-at-least-32-char-random-string
REFRESH_TOKEN_SECRET=replace-with-different-at-least-32-char-random-string

# Optional — only if you enable social login; when absent the provider's
# endpoint returns 500 "sign-in is not configured" instead of failing boot
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
