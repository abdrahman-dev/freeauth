{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "services/**/*",
    "utils/**/*",
    "config/**/*",
    "middleware/**/*",
    "model/**/*",
    "controllers/**/*",
    "routes/**/*",
    "tests/**/*",
    "vitest.config.ts",
    "app.js"
  ]
}